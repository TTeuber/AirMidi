# Common to both boards. Per-target files (sdkconfig.defaults.esp32c6 / .esp32s3) are applied on top by ESP-IDF.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Two app slots for OTA, a core dump slot and LittleFS storage (partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A new image boots "pending verify"; it must pass the self-test (main.c) or the next boot rolls back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Updates must be signed (RSA-3072, Secure Boot V2 format; the S3 has no ECDSA variant). The running firmware
# checks the signature before it switches; no eFuses are burned (no hardware Secure Boot). Dev builds use
# keys/dev_signing_key.pem (gitignored, build.sh creates it); releases are signed with a key kept in CI secrets.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/dev_signing_key.pem"
# A crash leaves a core dump in flash, shown in the log after the reboot (and downloadable from the web UI later).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# The console goes to the USB port on both boards: UART0's pins are the MIDI port (D6/D7).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Size over speed: the image must fit a 1.75 MB OTA slot with room for phases 4-6; at MIDI rates the CPU idles.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
# A stuck task reboots the box instead of leaving it silently dead.
CONFIG_ESP_TASK_WDT_PANIC=y

# Bluetooth: NimBLE host, BLE only. Two centrals connected to us (PORT_BLE_0/1) and one device we connect to
# ourselves (PORT_BLE_CENTRAL), so both roles. Bonds with devices that want pairing are kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# HTTPS to GitHub needs the common CAs, not the full Mozilla list.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# Power management (frequency scaling, optional automatic light sleep; mode chosen at runtime, see power.c).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_ESP_PHY_MAC_BB_PD=y

# WebSocket for the web UI's control surface (UMP over binary frames).
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# Sockets: the web server's 7 connections + its listening and control sockets, Network MIDI's UDP socket, an update
# download. The default 10 ran out with one browser tab open (keep-alive connections + the WebSocket): accept()
# failed with ENFILE before the server's own limit (and its drop-the-oldest) was ever reached.
CONFIG_LWIP_MAX_SOCKETS=16

# The default event loop runs our Wi-Fi handlers (joining, SNTP); its 2.3 KB stack overflowed on the S3 (Xtensa
# frames are bigger), the first time an S3 joined Wi-Fi.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
