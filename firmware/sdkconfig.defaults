# Common to both boards. Per-target files (sdkconfig.defaults.esp32c6 / .esp32s3) are applied on top by ESP-IDF.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# The console goes to the USB port on both boards: UART0's pins are the MIDI port (D6/D7).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# A stuck task reboots the box instead of leaving it silently dead.
CONFIG_ESP_TASK_WDT_PANIC=y

# Bluetooth: NimBLE host, BLE only, two centrals at once (PORT_BLE_0/1).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
